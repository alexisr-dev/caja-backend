# ==========================================
# Django
# ==========================================
SECRET_KEY=cambiame-en-produccion-genera-uno-nuevo
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=core.settings.development

# ==========================================
# PostgreSQL
# ==========================================
DB_NAME=caja_registradora
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ==========================================
# JWT
# ==========================================
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# ==========================================
# CORS (origenes permitidos, separados por coma)
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# Mercado Pago (sandbox)
# Obtener en: https://www.mercadopago.com.pe/developers/panel
# ==========================================
MP_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxx
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxx
MP_WEBHOOK_SECRET=cambiame

# ==========================================
# Email (2FA + reset password)
# Para Gmail: usar App Password, NO la contrasena normal
# https://myaccount.google.com/apppasswords
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password
DEFAULT_FROM_EMAIL=no-reply@supermercado-demo.com

# ==========================================
# Firebase Cloud Messaging
# Descargar serviceAccountKey.json desde Firebase Console
# Guardar en: backend/firebase/serviceAccountKey.json
# ==========================================
FIREBASE_CREDENTIALS_PATH=firebase/serviceAccountKey.json

# ==========================================
# Google Sign-In (OAuth)
# Client IDs autorizados, separados por coma.
# Para Flutter Android: usar el Web Client ID, no el Android Client ID
# ==========================================
GOOGLE_OAUTH_CLIENT_IDS=123456789-abc.apps.googleusercontent.com

# ==========================================
# IA Service (microservicio separado: caja-ia-service)
# Repo aparte: github.com/<tu-org>/caja-ia-service
# Backend solo lo consume via HTTP + API Key
# ==========================================
IA_SERVICE_URL=http://localhost:8001
# IA_SERVICE_API_KEY: DEBE ser el MISMO valor que en el .env del repo caja-ia-service
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
IA_SERVICE_API_KEY=genera-uno-con-el-comando-de-arriba

# ==========================================
# IGV
# ==========================================
IGV_PORCENTAJE=0.18

# ==========================================
# Cuentas demo (python manage.py seed_demo)
# ==========================================
# Contrasenas de las cuentas demo.admin@cajasmart.dev y demo.vendedor@cajasmart.dev.
# Estas cuentas llevan es_demo=True y omiten el codigo 2FA de 6 digitos al entrar.
# Son credenciales PUBLICAS a proposito: se muestran en /login del frontend, asi que
# deben coincidir con VITE_DEMO_ADMIN_PASSWORD / VITE_DEMO_VENDEDOR_PASSWORD.
# Si se dejan sin definir, el comando usa los valores por defecto de abajo.
DEMO_ADMIN_PASSWORD=DemoAdmin2025!
DEMO_VENDEDOR_PASSWORD=DemoVendedor2025!
